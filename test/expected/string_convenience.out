join empty: len=0 ''
join single: 'hello'
join multi: 'foo-bar-baz'
join empty sep: 'foobarbaz'
join wide sep: 'foo <-> bar <-> baz'
join ufcs: 'foo::bar::baz'
replace empty old: 'hello world'
replace no match: 'hello world'
replace single: 'hello goose'
replace multi: 'the cog sog on the mog'
replace overlap: 'bb'
replace remove: 'abcd'
replace exact: 'done'
replace empty src: ''
replace ufcs: 'quick red fox'
regex replace tpl: 'Hello Alice, welcome to Wonderland!'
regex replace no match: 'no template variables here'
regex replace transform: 'order: 20 items, 50 dollars, 10 bonus'
regex replace multi: '# a # b # c'
